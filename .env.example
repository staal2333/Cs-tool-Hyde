# Copy to .env.local for local dev (vercel dev), or set these in Vercel → Settings → Environment Variables.

# Shared password to open the app (required).
APP_PASSWORD=skift-mig

# Upstash Redis (added automatically when you connect an Upstash store in the
# Vercel Marketplace — Storage tab). Either KV_* or UPSTASH_* naming works.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Anthropic API key — powers the "Spørg Claude" win-the-customer suggestions (optional).
# Without it, the app still works; only the AI button is disabled.
ANTHROPIC_API_KEY=

# Optional: override the model. Default is claude-opus-4-8 (most capable).
# For cheaper, faster suggestions use claude-haiku-4-5.
CLAUDE_MODEL=claude-opus-4-8
